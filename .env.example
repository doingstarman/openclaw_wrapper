NODE_ENV=production
PORT=3001
MINIAPP_ALLOW_INSECURE_DEV=false
WEB_DIST_PATH=../web/dist

TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_ADMIN_USER_IDS=123456789

# The Docker compose file mounts the local OpenClaw state read-only and reads real sessions,
# token usage, cron metadata, logs, and local security posture from this directory.
OPENCLAW_STATE_DIR=/host/openclaw

# Optional future HTTP bridge. Leave blank unless you expose a dedicated miniapp-safe API.
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=

